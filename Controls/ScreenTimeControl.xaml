<UserControl x:Class="DeskWatch.Controls.ScreenTimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeskWatch.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundMediumBrush}"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    
    <ScrollViewer Style="{StaticResource ModernScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,32,48,48">
            
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="28" 
                           Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="Screen Time" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="{StaticResource SuccessBrush}" CornerRadius="10" Padding="8,4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LiveIndicator" Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>
            
            <!-- Big Today Card -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="32" Margin="0,0,0,24"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Today's Screen Time" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TodayTimeText" Text="0h 0m" FontSize="48" FontWeight="Bold" 
                                   Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                    
                    <!-- Mini stats on the right -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="#0AFFFFFF" CornerRadius="10" Padding="20,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="7-Day Average" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="WeeklyAvgText" Text="0h 0m" FontSize="20" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0AFFFFFF" CornerRadius="10" Padding="20,14">
                            <StackPanel>
                                <TextBlock Text="14-Day Total" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TotalTimeText" Text="0h 0m" FontSize="20" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Chart Section -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="28" Margin="0,0,0,24"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Past 14 Days" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                    
                    <!-- Bar Chart -->
                    <ItemsControl x:Name="BarChart" Height="160">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0" VerticalAlignment="Bottom" Cursor="Hand"
                                      MouseLeftButtonUp="BarChart_DayClick" Tag="{Binding}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Bar -->
                                    <Border x:Name="bar" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"
                                            Height="{Binding BarHeight}" MinHeight="4"
                                            Background="{StaticResource AccentPrimaryBrush}" Opacity="0.8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    
                                    <!-- Day Label -->
                                    <TextBlock Grid.Row="1" Text="{Binding DayLabel}" FontSize="10" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Date Range -->
                    <TextBlock x:Name="DateRangeText" Text="" FontSize="12" 
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Selected Day (hidden by default) -->
            <Border x:Name="SelectedDayPanel" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="28" Margin="0,0,0,24"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock x:Name="SelectedDayTitle" Text="Today" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedDayTime" Text=" — 0h 0m" FontSize="16" FontWeight="Medium" 
                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                    </StackPanel>
                    
                    <ItemsControl x:Name="AppBreakdownList"/>
                </StackPanel>
            </Border>
            
            <!-- Daily Log -->
            <TextBlock Text="Daily Log" FontSize="14" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
            
            <ItemsControl x:Name="DailyLogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" Background="{StaticResource CardBrush}" CornerRadius="12" 
                                Padding="20,16" Margin="0,0,0,8" Cursor="Hand"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                MouseLeftButtonUp="DailyLog_RowClick" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Date & Progress -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding FullDateLabel}" FontSize="14" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border x:Name="todayBadge" Background="{StaticResource SuccessBrush}" CornerRadius="4" 
                                                Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                                            <TextBlock Text="TODAY" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Progress Bar -->
                                    <Grid Width="300" HorizontalAlignment="Left">
                                        <Border Background="#10FFFFFF" CornerRadius="4" Height="8"/>
                                        <Border Background="{StaticResource AccentPrimaryBrush}" CornerRadius="4" Height="8"
                                                HorizontalAlignment="Left" Width="{Binding BarHeightPercentage}"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Time -->
                                <TextBlock Grid.Column="1" Text="{Binding FormattedTotalShort}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="todayBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
