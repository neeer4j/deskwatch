<UserControl x:Class="DeskWatch.Controls.ScreenTimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeskWatch.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900"
             Background="{StaticResource BackgroundMediumBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Padding="32,24,32,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Row -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="24" 
                               Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Screen Time" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                
                <!-- Summary Cards -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Today's Time -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="14" Padding="20" Margin="0,0,8,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AccentGradient}" CornerRadius="10" Padding="12" Margin="0,0,14,0">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TODAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TodayTimeText" Text="0h 0m" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Weekly Average -->
                    <Border Grid.Column="1" Background="{StaticResource CardGradient}" CornerRadius="14" Padding="20" Margin="8,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A2A3A" CornerRadius="10" Padding="12" Margin="0,0,14,0">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                                           Foreground="{StaticResource AccentPrimaryBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="DAILY AVG (7D)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="WeeklyAvgText" Text="0h 0m" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Total 14 Days -->
                    <Border Grid.Column="2" Background="{StaticResource CardGradient}" CornerRadius="14" Padding="20" Margin="8,0,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2A2A3A" CornerRadius="10" Padding="12" Margin="0,0,14,0">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL (14D)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TotalTimeText" Text="0h 0m" FontSize="24" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}" Padding="32,0,32,24">
            <StackPanel>
                <!-- Bar Chart Section -->
                <Border Background="{StaticResource CardGradient}" CornerRadius="16" Padding="24" Margin="0,0,0,20"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Chart Title -->
                        <TextBlock Text="Daily Screen Time - Past 14 Days" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                        
                        <!-- Bar Chart Area -->
                        <Grid Grid.Row="1">
                            <!-- Y-Axis Labels -->
                            <StackPanel x:Name="YAxisLabels" Width="50" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <TextBlock x:Name="YLabel4" Text="8h" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock x:Name="YLabel3" Text="6h" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,42,8,0"/>
                                <TextBlock x:Name="YLabel2" Text="4h" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,42,8,0"/>
                                <TextBlock x:Name="YLabel1" Text="2h" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,42,8,0"/>
                            </StackPanel>
                            
                            <!-- Grid Lines & Bars -->
                            <Grid Margin="50,0,0,0">
                                <!-- Horizontal Grid Lines -->
                                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,50"/>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                                <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,150"/>
                                
                                <!-- Bar Container -->
                                <ItemsControl x:Name="BarChart" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0" VerticalAlignment="Bottom" Cursor="Hand"
                                                  MouseLeftButtonUp="BarChart_DayClick" Tag="{Binding}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- The Bar -->
                                                <Border x:Name="bar" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"
                                                        Height="{Binding BarHeight}" MinHeight="4"
                                                        RenderTransformOrigin="0.5,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#06B6D4" Offset="0"/>
                                                                        <GradientStop Color="#14B8A6" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#22D3EE" Offset="0"/>
                                                                                <GradientStop Color="#06B6D4" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#06B6D4" Opacity="0.5"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#F59E0B" Offset="0"/>
                                                                                <GradientStop Color="#D97706" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="barScale" ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                                
                                                <!-- Time Label on Hover -->
                                                <Border x:Name="timeTooltip" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                        Background="#1A1A1A" CornerRadius="6" Padding="6,3" Margin="0,-25,0,0"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="{Binding FormattedTotalShort}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </Border>
                                                
                                                <!-- Day Label -->
                                                <TextBlock Grid.Row="1" Text="{Binding DayLabel}" FontSize="9" 
                                                           Foreground="{StaticResource TextMutedBrush}" 
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="bar" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="timeTooltip" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                        
                        <!-- X-Axis (Date Labels) - Only show a few key dates -->
                        <Grid Grid.Row="2" Margin="50,8,0,0">
                            <TextBlock x:Name="DateRangeText" Text="Jan 8 - Jan 21" FontSize="11" 
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- Selected Day Details -->
                <Border x:Name="SelectedDayPanel" Background="{StaticResource CardGradient}" CornerRadius="16" Padding="24" Margin="0,0,0,20"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Day Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                       Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SelectedDayTitle" Text="Tuesday, January 21" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="SelectedDayTime" Text=" — 4h 32m" FontSize="16" FontWeight="Medium" 
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </StackPanel>
                        
                        <!-- App Breakdown -->
                        <ItemsControl x:Name="AppBreakdownList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- App Name with Color Bar -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="4" Height="24" CornerRadius="2" Background="{Binding Color}" 
                                                        Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding AppName}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Time -->
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                       Margin="0,0,16,0"/>
                                            
                                            <!-- Percentage -->
                                            <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="{Binding FormattedPercentage}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                
                <!-- Daily Log Table -->
                <Border Background="{StaticResource CardGradient}" CornerRadius="16" Padding="24"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Daily Log" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                        
                        <!-- Table -->
                        <ItemsControl x:Name="DailyLogList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,4"
                                            Cursor="Hand" MouseLeftButtonUp="DailyLog_RowClick" Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Date -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FullDateLabel}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border x:Name="todayBadge" Background="{StaticResource AccentGradient}" CornerRadius="4" 
                                                        Padding="6,2" Margin="8,0,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="TODAY" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Day -->
                                            <TextBlock Grid.Column="1" Text="{Binding DayLabel}" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            
                                            <!-- Progress Bar -->
                                            <Grid Grid.Column="2" Margin="0,0,16,0">
                                                <Border Background="#1AFFFFFF" CornerRadius="4" Height="8"/>
                                                <Border Background="{StaticResource AccentGradient}" CornerRadius="4" Height="8"
                                                        HorizontalAlignment="Left" Width="{Binding BarHeightPercentage}"/>
                                            </Grid>
                                            
                                            <!-- Time -->
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedTotalShort}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentPrimaryBrush}" MinWidth="60" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="todayBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="#10FFFFFF"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
