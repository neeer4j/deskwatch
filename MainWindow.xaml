<Window x:Class="DeskWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskWatch"
        mc:Ignorable="d"
        Title="DeskWatch" Height="700" Width="1200" MinHeight="550" MinWidth="900"
        Background="{StaticResource BackgroundDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="12" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- Title Bar -->
                <RowDefinition Height="*"/>   <!-- Content -->
            </Grid.RowDefinitions>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                      CUSTOM TITLE BAR                            -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            
            <Border Grid.Row="0" Background="#0A0A0F" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Title & Logo -->
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Image Source="assets/deskwatchimg.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="DeskWatch" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" 
                                   Margin="8,0,0,0" VerticalAlignment="Center" Padding="6,2" 
                                   Background="#1A6366F1"/>
                    </StackPanel>
                    
                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE921;" Style="{StaticResource WindowChromeButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowChromeButton}" Click="MaximizeButton_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                        MAIN CONTENT                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Main Area -->
                    <ColumnDefinition Width="320"/>  <!-- Details Pane -->
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!--                          SIDEBAR                                 -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Margin="0,24,0,0">
                            <!-- Section: Controls -->
                            <TextBlock Text="CONTROLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="StartButton" Click="StartButton_Click" Content="Start Tracking" Tag="&#xE768;" 
                                    Style="{StaticResource SidebarButtonAccent}"/>
                            <Button x:Name="StopButton" Click="StopButton_Click" Content="Stop Tracking" Tag="&#xE71A;" 
                                    Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                            <Button x:Name="ResetButton" Click="ResetButton_Click" Content="Reset All Data" Tag="&#xE74D;" 
                                    Style="{StaticResource SidebarButton}"/>
                            
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,20"/>
                            
                            <!-- Section: Apps -->
                            <TextBlock Text="APPLICATIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="AddAppButton" Click="AddAppButton_Click" Content="Add Application" Tag="&#xE710;" 
                                    Style="{StaticResource SidebarButtonAccent}"/>
                            
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,20"/>
                            
                            <!-- Section: Settings -->
                            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="SettingsButton" Click="SettingsButton_Click" Content="Settings" Tag="&#xE713;" 
                                    Style="{StaticResource SidebarButton}"/>
                        </StackPanel>
                        
                        <!-- Status Footer -->
                        <Border Grid.Row="1" Background="#08FFFFFF" Padding="20,16" Margin="12,0,12,12" CornerRadius="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" x:Name="StatusIndicator"/>
                                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Tracking whitelisted applications only" FontSize="11" 
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!--                        APP GRID AREA                             -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                
                <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <Border Padding="32,28,32,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tracked Applications" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Background="{StaticResource AccentGradient}" CornerRadius="12" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppUsages.Count, FallbackValue=0}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Click on an app to view detailed statistics" FontSize="13" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- App Cards Grid -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}" Padding="24,0">
                        <ItemsControl ItemsSource="{Binding AppUsages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Background="{StaticResource CardGradient}" 
                                            CornerRadius="16" Margin="8" Width="130" Height="140" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                            Effect="{StaticResource CardShadow}"
                                            MouseLeftButtonUp="AppCard_Click" Tag="{Binding}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="cardScale" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="cardTranslate" Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <!-- Selection Glow Border -->
                                            <Border x:Name="glowBorder" CornerRadius="16" Opacity="0"
                                                    BorderThickness="2" BorderBrush="{StaticResource AccentGradient}"/>
                                            
                                            <!-- Content -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- App Icon with shadow -->
                                                <Border Background="#18FFFFFF" CornerRadius="14" Padding="10" Margin="0,0,0,10"
                                                        HorizontalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="36" Height="36" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                
                                                <!-- App Name -->
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                
                                                <!-- Time Display -->
                                                <TextBlock Text="{Binding FormattedTotal}" FontSize="15" FontWeight="Bold" 
                                                           Foreground="{StaticResource AccentPrimaryBrush}" 
                                                           TextAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Selection Indicator -->
                                            <Border Width="10" Height="10" CornerRadius="5" 
                                                    Background="{StaticResource AccentGradient}" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}, FallbackValue=Hidden}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#6366F1" Opacity="0.6"/>
                                                </Border.Effect>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Effect" Value="{StaticResource CardHoverShadow}"/>
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="cardTranslate" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="cardTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="card" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#252538" Offset="0"/>
                                                        <GradientStop Color="#1E1E30" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="glowBorder" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="No applications tracked yet" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Add Application' to start tracking" FontSize="13" 
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!--                       DETAILS PANEL                              -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                
                <Border Grid.Column="2" Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <!-- Details View -->
                        <StackPanel Margin="28" x:Name="DetailsPanel" Visibility="Hidden">
                            <!-- App Header -->
                            <Border Background="#10FFFFFF" CornerRadius="18" Padding="16" HorizontalAlignment="Center" Margin="0,16,0,20">
                                <Image x:Name="DetailsIcon" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock x:Name="DetailsName" Text="Application" FontSize="22" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" 
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Usage Statistics" FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                       TextAlignment="Center" Margin="0,0,0,32"/>
                            
                            <!-- Stat: Total Time -->
                            <Border Background="#10FFFFFF" CornerRadius="14" Padding="20" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentGradient}" CornerRadius="10" Padding="10" Margin="0,0,16,0">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL TIME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="DetailsTime" Text="00:00:00" FontSize="22" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Stat: Focus Count -->
                            <Border Background="#10FFFFFF" CornerRadius="14" Padding="20" Margin="0,0,0,40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3A" CornerRadius="10" Padding="10" Margin="0,0,16,0">
                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="DetailsCount" Text="0" FontSize="22" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Remove Button -->
                            <Button Click="RemoveApp_Click" Content="Remove Application" Style="{StaticResource DangerButton}" 
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="NoSelectionPanel">
                            <Border Background="#08FFFFFF" CornerRadius="20" Padding="20" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="40" 
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock x:Name="NoSelectionText" Text="Select an application" FontSize="17" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="NoSelectionSubText" Text="to view usage statistics" FontSize="13" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
