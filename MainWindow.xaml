<Window x:Class="DeskWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskWatch"
        xmlns:controls="clr-namespace:DeskWatch.Controls"
        mc:Ignorable="d"
        Title="DeskWatch" Height="700" Width="1200" MinHeight="550" MinWidth="900"
        Background="{StaticResource BackgroundDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="12" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- Title Bar -->
                <RowDefinition Height="*"/>   <!-- Content -->
            </Grid.RowDefinitions>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                      CUSTOM TITLE BAR                            -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            
            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Title & Logo -->
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Image Source="assets/deskwatchimg.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="DeskWatch" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" 
                                   Margin="8,0,0,0" VerticalAlignment="Center" Padding="6,2" 
                                   Background="#1A6366F1"/>
                    </StackPanel>
                    
                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE921;" Style="{StaticResource WindowChromeButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowChromeButton}" Click="MaximizeButton_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--                        MAIN CONTENT                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>  <!-- Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Main Area -->
                    <ColumnDefinition Width="320"/>  <!-- Details Pane -->
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!--                          SIDEBAR                                 -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Margin="0,24,0,0">
                            <!-- Section: Views -->
                            <TextBlock Text="VIEWS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="DashboardButton" Click="DashboardButton_Click" Content="Dashboard" Tag="&#xE80F;" 
                                    Style="{StaticResource SidebarButtonAccent}"/>
                            <Button x:Name="ScreenTimeButton" Click="ScreenTimeButton_Click" Content="Screen Time" Tag="&#xE916;" 
                                    Style="{StaticResource SidebarButton}"/>
                            
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,20"/>
                            
                            <!-- Section: Controls -->
                            <TextBlock Text="CONTROLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="StartButton" Click="StartButton_Click" Content="Start Tracking" Tag="&#xE768;" 
                                    Style="{StaticResource SidebarButtonAccent}"/>
                            <Button x:Name="StopButton" Click="StopButton_Click" Content="Stop Tracking" Tag="&#xE71A;" 
                                    Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                            <Button x:Name="ResetButton" Click="ResetButton_Click" Content="Reset All Data" Tag="&#xE74D;" 
                                    Style="{StaticResource SidebarButton}"/>
                            
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,20"/>
                            
                            <!-- Section: Apps -->
                            <TextBlock Text="APPLICATIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="AddAppButton" Click="AddAppButton_Click" Content="Add Application" Tag="&#xE710;" 
                                    Style="{StaticResource SidebarButtonAccent}"/>
                            
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="24,20"/>
                            
                            <!-- Section: Settings -->
                            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="26,0,0,12"/>
                            
                            <Button x:Name="SettingsButton" Click="SettingsButton_Click" Content="Settings" Tag="&#xE713;" 
                                    Style="{StaticResource SidebarButton}"/>
                        </StackPanel>
                        
                        <!-- Status Footer -->
                        <Border Grid.Row="1" Background="#08FFFFFF" Padding="20,16" Margin="12,0,12,12" CornerRadius="10">
                            <StackPanel>
                                <!-- Today's Time -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                               Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="TODAY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TodayTimeText" Text="00:00:00" FontSize="18" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                                
                                <!-- Status -->
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" x:Name="StatusIndicator"/>
                                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!--                        APP GRID AREA                             -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                
                <!-- Dashboard View (Column 1 + Column 2) -->
                <Grid x:Name="DashboardView" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    
                        <!-- Header with Search & Sort -->
                        <Border Padding="40,32,40,20">
                            <StackPanel>
                                <!-- Title Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <TextBlock Text="Tracked Applications" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="{StaticResource AccentPrimaryBrush}" CornerRadius="14" Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppUsages.Count, FallbackValue=0}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            
                                <!-- Search & Sort Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="360"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                
                                    <!-- Search Box -->
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" 
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" 
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"
                                                     TextChanged="SearchBox_TextChanged" CaretBrush="{StaticResource AccentPrimaryBrush}"/>
                                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search applications..." 
                                                       FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Visibility="Visible"/>
                                        </Grid>
                                    </Border>
                                
                                    <!-- Sort Buttons -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" 
                                            CornerRadius="12" Padding="4" Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="SortByTimeBtn" Background="{StaticResource AccentPrimaryBrush}" 
                                                    CornerRadius="8" Padding="14,10" Cursor="Hand"
                                                    MouseLeftButtonUp="SortByTime_Click" ToolTip="Sort by Time">
                                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="SortByNameBtn" Background="Transparent" 
                                                    CornerRadius="8" Padding="14,10" Cursor="Hand"
                                                    MouseLeftButtonUp="SortByName_Click" ToolTip="Sort by Name">
                                                <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="SortBySessionsBtn" Background="Transparent" 
                                                    CornerRadius="8" Padding="14,10" Cursor="Hand"
                                                    MouseLeftButtonUp="SortBySessions_Click" ToolTip="Sort by Sessions">
                                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    
                        <!-- App Cards Grid -->
                        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}" Padding="32,8,32,32">
                            <ItemsControl ItemsSource="{Binding AppUsages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="card" Background="{StaticResource CardBrush}" 
                                                CornerRadius="16" Margin="8" Width="150" Height="160" Cursor="Hand"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                MouseLeftButtonUp="AppCard_Click" Tag="{Binding}">
                                            <Grid>
                                                <!-- Selection Border -->
                                                <Border x:Name="glowBorder" CornerRadius="16" Opacity="0"
                                                        BorderThickness="2" BorderBrush="{StaticResource AccentPrimaryBrush}"/>
                                            
                                                <!-- Content -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                                    <!-- App Icon -->
                                                    <Border Background="#12FFFFFF" CornerRadius="14" Padding="12" Margin="0,0,0,12"
                                                            HorizontalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="40" Height="40" 
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                
                                                    <!-- App Name -->
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                
                                                    <!-- Time Display -->
                                                    <TextBlock Text="{Binding FormattedTotal}" FontSize="17" FontWeight="Bold" 
                                                               Foreground="{StaticResource AccentPrimaryBrush}" 
                                                               TextAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            
                                                <!-- Selection Indicator -->
                                                <Border Width="10" Height="10" CornerRadius="5" 
                                                        Background="{StaticResource AccentPrimaryBrush}" 
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}, FallbackValue=Hidden}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="#3A3A3A"/>
                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="#2A2A3A"/>
                                                <Setter TargetName="glowBorder" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    
                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Background="#08FFFFFF" CornerRadius="24" Padding="24" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="No applications tracked yet" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'Add Application' to start tracking" FontSize="13" 
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!--                       DETAILS PANEL                              -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                
                <Border Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Details View -->
                        <StackPanel Margin="32,40,32,48" x:Name="DetailsPanel" Visibility="Hidden">
                            <!-- App Header Card -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="28" 
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,24">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#0CFFFFFF" CornerRadius="20" Padding="20" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Image x:Name="DetailsIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock x:Name="DetailsName" Text="Application" FontSize="20" FontWeight="Bold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Stats Grid -->
                            <TextBlock Text="USAGE STATISTICS" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,16"/>
                            
                            <!-- Stat: Today's Time -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,10"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentPrimaryBrush}" CornerRadius="12" Width="44" Height="44">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="17" 
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="DetailsTodayTime" Text="00:00:00" FontSize="24" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Stat: Total Time -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,10"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3A" CornerRadius="12" Width="44" Height="44">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="17" 
                                                   Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="ALL TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="DetailsTime" Text="00:00:00" FontSize="24" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Stat: Sessions Count -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,32"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3A" CornerRadius="12" Width="44" Height="44">
                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="17" 
                                                   Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="SESSIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="DetailsCount" Text="0" FontSize="24" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Remove Button -->
                            <Button Click="RemoveApp_Click" Content="Remove Application" Style="{StaticResource DangerButton}" 
                                    HorizontalAlignment="Stretch" Height="48"/>
                        </StackPanel>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="NoSelectionPanel" Margin="32">
                            <Border Background="#06FFFFFF" CornerRadius="24" Padding="28" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="44" 
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock x:Name="NoSelectionText" Text="Select an application" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                            <TextBlock x:Name="NoSelectionSubText" Text="to view usage statistics" FontSize="14" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Inline Settings Panel -->
                        <ScrollViewer x:Name="InlineSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20">
                            <StackPanel>
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                               Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0"/>
                                </StackPanel>
                                
                                <!-- Startup Section -->
                                <TextBlock Text="STARTUP" FontSize="10" FontWeight="Bold" 
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                
                                <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Start with Windows" FontSize="14" FontWeight="Medium" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Launch DeskWatch on login" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="InlineAutoStartToggle" HorizontalAlignment="Right" 
                                                Width="44" Height="24" CornerRadius="12" Cursor="Hand" Background="#404040"
                                                MouseLeftButtonUp="InlineAutoStartToggle_Click">
                                            <Border x:Name="InlineAutoStartThumb" Width="20" Height="20" CornerRadius="10" 
                                                    Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="InlineAutoStartTranslate" X="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Minimize to Tray" FontSize="14" FontWeight="Medium" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Hide to tray when closing" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="InlineTrayToggle" HorizontalAlignment="Right" 
                                                Width="44" Height="24" CornerRadius="12" Cursor="Hand" Background="#404040"
                                                MouseLeftButtonUp="InlineTrayToggle_Click">
                                            <Border x:Name="InlineTrayThumb" Width="20" Height="20" CornerRadius="10" 
                                                    Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="InlineTrayTranslate" X="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,24">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Idle Detection" FontSize="14" FontWeight="Medium" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Pause when away" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="InlineIdleToggle" HorizontalAlignment="Right" 
                                                Width="44" Height="24" CornerRadius="12" Cursor="Hand" Background="#404040"
                                                MouseLeftButtonUp="InlineIdleToggle_Click">
                                            <Border x:Name="InlineIdleThumb" Width="20" Height="20" CornerRadius="10" 
                                                    Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="InlineIdleTranslate" X="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- Data Section -->
                                <TextBlock Text="DATA" FontSize="10" FontWeight="Bold" 
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                
                                <Button Click="InlineExportData_Click" Style="{StaticResource SecondaryButton}" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Export Data" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Click="InlineImportData_Click" Style="{StaticResource SecondaryButton}" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Import Data" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Click="InlineClearData_Click" Style="{StaticResource DangerButton}" 
                                        HorizontalAlignment="Stretch" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
