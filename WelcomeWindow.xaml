<Window x:Class="DeskWatch.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskWatch"
        Title="Welcome to DeskWatch" Height="480" Width="640" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI">
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Fade In Animation -->
                    <DoubleAnimation Storyboard.TargetName="MainContent" 
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="CardTransform" 
                                     Storyboard.TargetProperty="Y"
                                     From="20" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    
    <!-- Animated Background Gradient -->
    <Border CornerRadius="20" MouseLeftButtonDown="Window_MouseDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1A1A" Offset="0"/>
                <GradientStop Color="#242424" Offset="0.5"/>
                <GradientStop Color="#2E2E2E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
        </Border.Effect>
        
        <Grid x:Name="MainContent">
            <!-- Decorative Gradient Orbs -->
            <Ellipse Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-100,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#206366F1" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-80,-0,-0,-80">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#158B5CF6" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Main Card -->
            <Border Background="#10FFFFFF" CornerRadius="24" Padding="50,40" Margin="50"
                    BorderBrush="#18FFFFFF" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CardTransform" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.4"/>
                </Border.Effect>
                
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Logo -->
                    <Border Background="#15FFFFFF" CornerRadius="20" Padding="16" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#6366F1" Opacity="0.3"/>
                        </Border.Effect>
                        <Image Source="assets/deskwatchimg.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <!-- App Name with Gradient -->
                    <TextBlock FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                <GradientStop Color="#A855F7" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        DeskWatch
                    </TextBlock>
                    
                    <!-- Tagline -->
                    <TextBlock Text="Track your productivity in style" FontSize="17" Foreground="#E0E0E0" 
                               HorizontalAlignment="Center" Margin="0,0,0,32"/>
                    
                    <!-- Description -->
                    <TextBlock TextAlignment="Center" FontSize="14" Foreground="#9090A0" 
                               MaxWidth="400" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,40">
                        Welcome! DeskWatch helps you understand where your time goes by intelligently 
                        tracking your activity across all applications.
                    </TextBlock>
                    
                    <!-- Continue Button -->
                    <Button Content="Get Started" Width="200" Height="52" FontSize="16" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButton}" Click="Continue_Click"/>
                    
                    <!-- Version -->
                    <TextBlock Text="Version 1.0" FontSize="11" Foreground="#505060" 
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
