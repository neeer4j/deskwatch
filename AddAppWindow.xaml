<Window x:Class="DeskWatch.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Application" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="16" Background="{StaticResource BackgroundLightBrush}" 
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource HardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- List -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Background="#0A0A12" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Add Application" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" 
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>
            
            <!-- Header -->
            <StackPanel Grid.Row="1" Margin="24,20,24,16">
                <TextBlock Text="Select a Running Application" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Choose from currently running applications to add to your tracking list" 
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- Application List -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" 
                    Margin="20,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer Style="{StaticResource ModernScrollViewer}" Padding="6">
                    <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0" 
                             Foreground="{StaticResource TextSecondaryBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon Container -->
                                    <Border Background="#10FFFFFF" CornerRadius="10" Width="38" Height="38">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" 
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    
                                    <!-- App Info -->
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MainWindowTitle}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                        <TextBlock Text="{Binding ProcessName}" FontSize="11" 
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
            
            <!-- Action Buttons -->
            <Grid Grid.Row="3" Margin="20,20,20,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" 
                        Grid.Column="1" Margin="0,0,12,0" Padding="20,12"/>
                <Button Content="Add Selected" Click="Add_Click" Style="{StaticResource PrimaryButton}" 
                        Grid.Column="2" Padding="24,12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
