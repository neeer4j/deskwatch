<Window x:Class="DeskWatch.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Application" Height="560" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="16" Background="{StaticResource BackgroundLightBrush}" 
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource HardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Tabs -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Background="#1A1A1A" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Add Application" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" 
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>
            
            <!-- Tab Buttons -->
            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="RunningAppsTab" Content="Running Apps" Click="RunningAppsTab_Click"
                        Style="{StaticResource TabButton}" Margin="0,0,6,0"/>
                <Button x:Name="BrowseTab" Content="Browse for App" Click="BrowseTab_Click"
                        Grid.Column="1" Style="{StaticResource TabButtonInactive}" Margin="6,0,0,0"/>
            </Grid>
            
            <!-- Running Apps Content -->
            <Grid x:Name="RunningAppsContent" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Select from currently running applications" 
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                           Margin="24,0,24,12"/>
                
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" 
                        Margin="20,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer Style="{StaticResource ModernScrollViewer}" Padding="6">
                        <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0" 
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ModernListBoxItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon Container -->
                                        <Border Background="#10FFFFFF" CornerRadius="10" Width="38" Height="38">
                                            <Image Source="{Binding Icon}" Width="22" Height="22" 
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        
                                        <!-- App Info -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MainWindowTitle}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                            <TextBlock Text="{Binding ProcessName}" FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </Grid>
            
            <!-- Browse Content -->
            <Grid x:Name="BrowseContent" Grid.Row="2" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <Border Background="#10FFFFFF" CornerRadius="24" Width="100" Height="100" 
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="40" 
                                   Foreground="{StaticResource AccentPrimaryBrush}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="Browse for an Application" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Select any .exe file to add it to your tracking list" 
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>
                    
                    <Button Content="Browse for .exe file" Click="BrowseFile_Click" 
                            Style="{StaticResource PrimaryButton}" Padding="32,14" 
                            HorizontalAlignment="Center"/>
                    
                    <!-- Selected file info -->
                    <Border x:Name="SelectedFileInfo" Visibility="Collapsed" 
                            Background="{StaticResource SurfaceBrush}" CornerRadius="12" 
                            Margin="0,24,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Background="#10FFFFFF" CornerRadius="10" Width="44" Height="44">
                                <Image x:Name="BrowsedAppIcon" Width="28" Height="28" 
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BrowsedAppName" Text="Application Name" 
                                           FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="BrowsedAppPath" Text="Path" FontSize="11" 
                                           Foreground="{StaticResource TextMutedBrush}" 
                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            
            <!-- Action Buttons -->
            <Grid Grid.Row="3" Margin="20,16,20,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" 
                        Grid.Column="1" Margin="0,0,12,0" Padding="20,12"/>
                <Button x:Name="AddButton" Content="Add Selected" Click="Add_Click" 
                        Style="{StaticResource PrimaryButton}" Grid.Column="2" Padding="24,12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
