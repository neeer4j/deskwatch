<Window x:Class="DeskWatch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="640" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Border CornerRadius="16" Background="{StaticResource BackgroundLightBrush}" 
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Effect="{StaticResource HardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Background="#1A1A1A" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                   Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" 
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>
            
            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewer}" Padding="32,28">
                <StackPanel>
                    <!-- Startup Section -->
                    <TextBlock Text="STARTUP" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                    
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" FontSize="14" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Launch DeskWatch automatically when you log in" 
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <!-- Toggle Switch -->
                            <Border Grid.Column="1" x:Name="AutoStartToggle" MouseLeftButtonUp="AutoStartToggle_Click"
                                    Width="48" Height="26" CornerRadius="13" Cursor="Hand" Margin="12,0,0,0"
                                    Background="#3A3A4A">
                                <Border x:Name="ToggleThumb" Width="22" Height="22" CornerRadius="11" 
                                        Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Minimize to Tray" FontSize="14" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Hide to system tray when closing the window" 
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <!-- Toggle Switch -->
                            <Border Grid.Column="1" x:Name="MinimizeToTrayToggle" MouseLeftButtonUp="MinimizeToTrayToggle_Click"
                                    Width="48" Height="26" CornerRadius="13" Cursor="Hand" Margin="12,0,0,0"
                                    Background="#3A3A4A">
                                <Border x:Name="TrayToggleThumb" Width="22" Height="22" CornerRadius="11" 
                                        Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TrayThumbTranslate" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Idle Detection" FontSize="14" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Pause tracking when you're away from the computer" 
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <!-- Toggle Switch -->
                            <Border Grid.Column="1" x:Name="IdleDetectionToggle" MouseLeftButtonUp="IdleDetectionToggle_Click"
                                    Width="48" Height="26" CornerRadius="13" Cursor="Hand" Margin="12,0,0,0"
                                    Background="#3A3A4A">
                                <Border x:Name="IdleToggleThumb" Width="22" Height="22" CornerRadius="11" 
                                        Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IdleThumbTranslate" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Data Section -->
                    <TextBlock Text="DATA" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                    
                    <!-- Export/Import -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Export Data" FontSize="14" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Save your tracking data to a JSON file" 
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Click="ExportData_Click" 
                                    Style="{StaticResource SecondaryButton}" Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Export" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Import Data" FontSize="14" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Load tracking data from a JSON file" 
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Click="ImportData_Click" 
                                    Style="{StaticResource SecondaryButton}" Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Import" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Clear Data -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="Clear All Data" FontSize="14" FontWeight="Medium" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Remove all tracked apps and reset usage statistics" 
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="0,4,0,12" TextWrapping="Wrap"/>
                            <Button Content="Clear All Data" Click="ClearData_Click" 
                                    Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- About Section -->
                    <TextBlock Text="ABOUT" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                    
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Image Source="assets/deskwatchimg.png" Width="24" Height="24" 
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="DeskWatch" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentPrimaryBrush}" 
                                           Margin="8,0,0,0" VerticalAlignment="Center" Padding="6,2" 
                                           Background="#1A6366F1"/>
                            </StackPanel>
                            <TextBlock Text="Version 1.0.0" FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="Track your app usage and boost productivity" FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" Padding="24,16" Background="#1A1A1A" CornerRadius="0,0,16,16">
                <Button Content="Done" Click="Close_Click" Style="{StaticResource PrimaryButton}" 
                        HorizontalAlignment="Right" Padding="32,12"/>
            </Border>
        </Grid>
    </Border>
</Window>
